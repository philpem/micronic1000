;; UPC-E parity -- generated by tools/gen_tables.py.
;;
;; UPC-E draws neither its number system nor its check digit.  Both
;; live in which of the six digits use the even-parity G code.  One
;; bit per digit, first digit in bit 5, G (even) = 1.
;;
;; These ten are number system 0, indexed by check digit.  Number
;; system 1 is the same set complemented in six bits, so the decoder
;; tries the pattern as it stands and then XOR 3Fh, rather than
;; carrying a second table.

upce_parity:
    defb $38          ; check 0  EEEOOO
    defb $34          ; check 1  EEOEOO
    defb $32          ; check 2  EEOOEO
    defb $31          ; check 3  EEOOOE
    defb $2C          ; check 4  EOEEOO
    defb $26          ; check 5  EOOEEO
    defb $23          ; check 6  EOOOEE
    defb $2A          ; check 7  EOEOEO
    defb $29          ; check 8  EOEOOE
    defb $25          ; check 9  EOOEOE
