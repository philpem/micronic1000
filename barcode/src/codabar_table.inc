;; Codabar -- generated by tools/gen_tables.py.
;;
;; Seven elements per character: four bars and three spaces,
;; alternating and starting with a bar.  Bit 6 is the first element.
;; A-D are the start/stop characters and may not appear in the data.

codabar_count:  defb 20
codabar_table:
    defb $03,'0'   ; NNNNNWW 
    defb $06,'1'   ; NNNNWWN 
    defb $09,'2'   ; NNNWNNW 
    defb $60,'3'   ; WWNNNNN 
    defb $12,'4'   ; NNWNNWN 
    defb $42,'5'   ; WNNNNWN 
    defb $21,'6'   ; NWNNNNW 
    defb $24,'7'   ; NWNNWNN 
    defb $30,'8'   ; NWWNNNN 
    defb $48,'9'   ; WNNWNNN 
    defb $0A,'-'   ; NNNWNWN 
    defb $18,'$'   ; NNWWNNN 
    defb $45,':'   ; WNNNWNW 
    defb $51,'/'   ; WNWNNNW 
    defb $54,'.'   ; WNWNWNN 
    defb $15,'+'   ; NNWNWNW 
    defb $1A,'A'   ; NNWWNWN start/stop
    defb $29,'B'   ; NWNWNNW start/stop
    defb $0D,'C'   ; NNNWWNW start/stop
    defb $0E,'D'   ; NNNWWWN start/stop
