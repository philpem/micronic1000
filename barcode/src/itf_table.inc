;; Interleaved 2 of 5 -- generated by tools/gen_tables.py.
;;
;; Five elements per digit, exactly two of them wide.  Bit 4 is the
;; first element.  Bars carry one digit of a pair and spaces the
;; other, woven together -- hence the name.

itf_table:
    defb $06          ; 0  NNWWN
    defb $11          ; 1  WNNNW
    defb $09          ; 2  NWNNW
    defb $18          ; 3  WWNNN
    defb $05          ; 4  NNWNW
    defb $14          ; 5  WNWNN
    defb $0C          ; 6  NWWNN
    defb $03          ; 7  NNNWW
    defb $12          ; 8  WNNWN
    defb $0A          ; 9  NWNWN
